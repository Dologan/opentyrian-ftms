diff --git a/src/bike.c b/src/bike.c
new file mode 100644
index 0000000..014e0e3
--- /dev/null
+++ b/src/bike.c
@@ -0,0 +1,100 @@
+// SPIKE (throwaway): see bike.h.
+#include "bike.h"
+
+#include "logging.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { unsigned long tick; unsigned watts, rpm; } BikeRow;
+
+static BikeRow *rows = NULL;
+static size_t row_count = 0;
+static bool active = false;
+static unsigned long tick = 0;
+static unsigned cur_watts = 0, cur_rpm = 0;
+static unsigned acc = 0;   // remainder in 1/BIKE_REF_WATTS units of base_add
+
+static bool add_row(unsigned long t, unsigned w, unsigned rpm)
+{
+	BikeRow *grown = realloc(rows, (row_count + 1) * sizeof *rows);
+	if (grown == NULL)
+		return false;
+	rows = grown;
+	rows[row_count++] = (BikeRow){ t, w, rpm };
+	return true;
+}
+
+bool bike_load(const char *spec)
+{
+	row_count = 0;
+	active = false;
+	
+	if (strncmp(spec, "const:", 6) == 0)
+	{
+		unsigned w, rpm = 0;
+		if (sscanf(spec + 6, "%u,%u", &w, &rpm) < 1)
+		{
+			logError("--regress-bike: bad const spec '%s'", spec);
+			return false;
+		}
+		active = add_row(0, w, rpm);
+		return active;
+	}
+	
+	FILE *f = fopen(spec, "rb");
+	if (f == NULL)
+	{
+		logError("--regress-bike: cannot open '%s'", spec);
+		return false;
+	}
+	char line[256];
+	unsigned long last = 0;
+	while (fgets(line, sizeof line, f))
+	{
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r' || strncmp(line, "tick", 4) == 0)
+			continue;
+		unsigned long t;
+		unsigned w, rpm = 0;
+		if (sscanf(line, "%lu,%u,%u", &t, &w, &rpm) < 2 || t < last || !add_row(t, w, rpm))
+		{
+			logError("--regress-bike: bad row '%s' (rows must be tick,watts[,rpm] with ascending ticks)", line);
+			fclose(f);
+			return false;
+		}
+		last = t;
+	}
+	fclose(f);
+	active = row_count > 0;
+	return active;
+}
+
+bool bike_active(void) { return active; }
+
+void bike_level_start(void)
+{
+	tick = 0;
+	acc = 0;
+	cur_watts = cur_rpm = 0;
+}
+
+unsigned bike_power_add(unsigned base_add)
+{
+	size_t i = 0;
+	while (i + 1 < row_count && rows[i + 1].tick <= tick)
+		++i;
+	cur_watts = rows[i].watts;
+	cur_rpm = rows[i].rpm;
+	++tick;
+	
+	// add = watts * base_add / 150, remainder carried: exact and drift-free.
+	acc += cur_watts * base_add;
+	unsigned add = acc / BIKE_REF_WATTS;
+	acc %= BIKE_REF_WATTS;
+	return add;
+}
+
+unsigned bike_watts(void) { return cur_watts; }
+unsigned bike_cadence_rpm(void) { return cur_rpm; }
+unsigned long bike_tick(void) { return tick; }
diff --git a/src/bike.h b/src/bike.h
new file mode 100644
index 0000000..f320958
--- /dev/null
+++ b/src/bike.h
@@ -0,0 +1,38 @@
+// SPIKE (throwaway): exercise-bike input model for the Phase 0 viability study.
+//
+// A bike source maps the game tick to (watts, cadence).  The generator refill
+// in the level loop (tyrian2.c "Power Bar") then uses bike_power_add() instead
+// of the fixed `powerAdd`.  Everything here is integer-only and a pure function
+// of the tick, so a scripted trace replays bit-identically in the regress
+// harness.  A live BLE feed would implement the same two calls (sample the
+// latest FTMS notification once per tick and quantise it).
+#ifndef BIKE_H
+#define BIKE_H
+
+#include <stdbool.h>
+
+// 150 W is the "neutral" effort: it refills exactly `powerAdd` per tick, i.e.
+// the equipped generator's stock rate.  Other wattages scale linearly.
+#define BIKE_REF_WATTS 150
+
+// Loads a trace: "const:WATTS[,RPM]" or a CSV file of "tick,watts[,rpm]" rows
+// ('#' comments; piecewise-constant, the last row with tick <= now applies).
+// Returns false (and logs) on a parse error.
+bool bike_load(const char *spec);
+bool bike_active(void);
+
+// Called when a level (re)starts: rewinds the tick and the accumulator.
+void bike_level_start(void);
+
+// Advances one game tick and returns the generator refill for this tick,
+// replacing `power += powerAdd`.  `base_add` is the equipped generator's
+// powerAdd (the value 150 W maps to).  Exact: the sub-unit remainder is carried
+// in an integer accumulator, so 150 W reproduces the stock refill bit for bit.
+unsigned bike_power_add(unsigned base_add);
+
+// Last sampled values (for the HUD and the log).
+unsigned bike_watts(void);
+unsigned bike_cadence_rpm(void);
+unsigned long bike_tick(void);
+
+#endif
