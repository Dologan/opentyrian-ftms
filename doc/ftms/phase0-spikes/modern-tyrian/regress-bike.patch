diff --git a/tools/check_bike.sh b/tools/check_bike.sh
new file mode 100755
index 0000000..6cd557f
--- /dev/null
+++ b/tools/check_bike.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# check_bike.sh -- SPIKE guard for --regress-bike (watts-driven generator refill).
+#   1. flag OFF: demo3-d4 still equals its committed baseline
+#   2. 150 W constant == flag-off frames (150 W is the neutral rate)
+#   3. scripted ride twice: identical frames, state hashes and per-tick log
+#   4. scripted ride differs from flag-off (the power change is observable)
+set -uo pipefail
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; cd "$ROOT" || exit 1
+DATA=${TYRIAN_DATA:-data}; T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+run() { local l=$1; shift
+  SDL_VIDEO_DRIVER=dummy SDL_AUDIO_DRIVER=dummy ./opentyrian --data="$DATA" \
+    --regress-out="$T/$l.f" --regress-state-out="$T/$l.s" "$@" >"$T/$l.log" 2>&1 || { echo "FAIL $l: run failed"; tail "$T/$l.log"; exit 1; }; }
+S="--regress-script=1:3 --regress-seed=32402394 --regress-detail=2 --regress-frames=600"
+R=test/bike/ride1.csv
+run demo3 --regress-demo=3 --regress-detail=4
+cmp -s "$T/demo3.f" test/regress/demo3-d4.txt || { echo "FAIL flag-off demo3-d4 != baseline"; exit 1; }
+echo "PASS bike-off: demo3-d4 matches committed baseline"
+run off $S; run c150 $S --regress-bike=const:150
+cmp -s "$T/off.f" "$T/c150.f" || { echo "FAIL 150 W frames != flag-off"; exit 1; }
+echo "PASS bike-150W: frames identical to flag-off (neutral rate)"
+run a $S --regress-bike=$R --regress-bike-log="$T/a.log2"; run b $S --regress-bike=$R --regress-bike-log="$T/b.log2"
+for x in f s log2; do cmp -s "$T/a.$x" "$T/b.$x" || { echo "FAIL ride not deterministic ($x)"; exit 1; }; done
+echo "PASS bike-determinism: frames, state hashes and per-tick log identical across runs"
+cmp -s "$T/off.f" "$T/a.f" && { echo "FAIL ride frames equal flag-off"; exit 1; }
+echo "PASS bike-observable: ride frames differ from flag-off (first diff line $(diff "$T/off.f" "$T/a.f" | head -1))"
